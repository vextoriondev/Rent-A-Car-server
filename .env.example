DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
POSTGRES_DB=rentflow
POSTGRES_USER=rentflow
POSTGRES_PASSWORD=rentflow-local-only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
CELERY_BROKER_URL=redis://localhost:6379/0

# Production (Railway): see docs/DEPLOY_RAILWAY.md
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# PRIVATE_MEDIA_ROOT=/data/private_media

# Email (Resend): create an API key at resend.com/api-keys (permission: Sending access) and verify your domain at resend.com/domains.
# For a first test you can use EMAIL_FROM_ADDRESS=onboarding@resend.dev, which only delivers to your own Resend account email.
# RESEND_API_KEY=re_...
# EMAIL_FROM_ADDRESS=notifications@your-domain.com
# EMAIL_FROM_NAME=RentFlow
